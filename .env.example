# ─── App ───
NEXT_PUBLIC_URL=http://localhost:3000

# ─── Database (Neon Postgres) ───
DATABASE_URL=

# ─── Corsair (hosted app SDK) ───
# Developer API key from the Corsair dashboard (starts with ch_)
CORSAIR_DEV_KEY=
# Instance id from the Corsair dashboard
CORSAIR_INSTANCE_ID=

# ─── Google Gemini (LLM + embeddings) ───
# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Realtime (Upstash Redis pub/sub for SSE across serverless) ───
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
