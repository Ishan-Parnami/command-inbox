# ─── App ───
NEXT_PUBLIC_URL=http://localhost:3000

# ─── Auth.js (Google sign-in) ───
NEXTAUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3000

# <NEXTAUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=your_google_oauth_client_id_here
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret_here

# ─── Database (Neon Postgres) ───
DATABASE_URL=your_database_url_here

# ─── Corsair (hosted app SDK) ───
CORSAIR_DEV_KEY=your_corsair_dev_key_here
CORSAIR_INSTANCE_ID=your_corsair_instance_id_here
CORSAIR_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ─── Google Gemini (LLM + embeddings) ───
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_FALLBACK_1=
GEMINI_API_KEY_FALLBACK_2=

# ─── AI quota (free tier — daily limits per user, UTC reset) ───
# Requires UPSTASH_REDIS_REST_* below. Omit to use defaults.
AI_LIMIT_AGENT=15
AI_LIMIT_SEARCH=30
AI_LIMIT_PARSE=20
AI_LIMIT_BRIEF=5
AI_LIMIT_ACTION_EXTRACT=10
BACKGROUND_CLASSIFY_DAILY_LIMIT=50

# ─── Realtime + AI quotas (Upstash Redis — required for rate limiting) ───
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Without Redis above, AI limits are NOT enforced (fail-open).

# ─── Cron (Send Later) ───
# Protects /api/cron/send-later when triggered manually. Vercel Cron is allowed
# automatically via its x-vercel-cron header.
CRON_SECRET=openssl_rand_hex_32
